{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handshake: richiesta del client (POST /api/handshake, in chiaro)",
  "description": "Numeri in esadecimale maiuscolo senza zeri iniziali. p e g devono essere quelli del gruppo 14 di RFC 3526 (const). A ha da 2 a 512 cifre: non puo' valere 0 o 1.",
  "type": "object",
  "required": ["p", "g", "A"],
  "properties": {
    "p": {
      "type": "string",
      "const": ""
    },
    "g": { "type": "string", "const": "2" },
    "A": { "type": "string", "pattern": "^[1-9A-F][0-9A-F]{1,511}$" }
  },
  "additionalProperties": false
}
